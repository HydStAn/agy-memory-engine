# ==============================================================================
# AGY Memory Engine - Configuration File
# ==============================================================================

# LLM model used for background memory extraction, summarization & consolidation
AGY_MEMORY_MODEL=gemini-3.8-flash-low

# SQLite Database Storage Paths
AGY_MEMORY_DB=~/.gemini/memory.db
AGY_TURN_QUEUE_DB=~/.gemini/turn_queue.db

# Calm-Memory Debounce Settings (in seconds)
# INACTIVITY: Minimum seconds of silence required before processing a batch
AGY_MEMORY_INACTIVITY_SECONDS=300

# MAX_WAIT: Maximum seconds a pending turn can wait before forced execution
AGY_MEMORY_MAX_WAIT_SECONDS=900

# Telegram Notification Recipient for autonomous memory updates (optional: your numeric Telegram user or group ID)
AGY_MEMORY_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Path to Antigravity CLI binary
AGY_BIN=agy

# Real-Time Debug Dashboard (Web UI)
AGY_MEMORY_DEBUG_DASHBOARD=true
AGY_MEMORY_DASHBOARD_PORT=8085
AGY_MEMORY_DASHBOARD_HOST=127.0.0.1


# Required for automatic extraction: trusted OpenAI-compatible chat-completions URL.
# No tools are offered to this endpoint; empty configuration fails closed.
AGY_MEMORY_INFERENCE_URL=
AGY_MEMORY_INFERENCE_MODEL=
AGY_MEMORY_INFERENCE_KEY=

# Optional archive root, model cache and sync lock overrides.
# Non-default memory databases get separate archive subdirectories.
AGY_MEMORY_ARCHIVE=
AGY_MEMORY_CACHE=
AGY_MEMORY_SYNC_LOCK=

# Optional explicit dashboard bearer token. Otherwise a private local file is used.
AGY_MEMORY_DASHBOARD_TOKEN=
